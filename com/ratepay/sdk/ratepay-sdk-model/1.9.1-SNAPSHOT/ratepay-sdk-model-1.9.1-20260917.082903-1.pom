<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ratepay.sdk</groupId>
        <artifactId>ratepay-sdk-parent</artifactId>
        <version>1.9.1-SNAPSHOT</version>
    </parent>

    <artifactId>ratepay-sdk-model</artifactId>
    <name>Ratepay SDK (Model)</name>
    <description>
        Contract layer: typed request/response DTOs and their JSON (de)serialization.
        DTOs are generated from the published Payment API's OpenAPI contract.
    </description>

    <properties>
        <openapi-generator.version>7.24.0</openapi-generator.version>

        <!-- Pinned, committed copy of the Payment API V2 spec. Bumping its content IS the
             contract-change PR. -->
        <openapi.spec.file>${project.basedir}/codegen/spec/payment_api.yaml</openapi.spec.file>

        <!-- Generated code only, one package per API domain. Hand-written types live under
             com.ratepay.sdk.model.* directly, so the drift gate never touches them. -->
        <openapi.model.package.payment>com.ratepay.sdk.model.api.payment</openapi.model.package.payment>
        <openapi.model.package.secci>com.ratepay.sdk.model.api.secci</openapi.model.package.secci>

        <!-- Output root; the kotlin generator appends src/main/kotlin/<package>. CI's drift job
             regenerates in place (so ktlint-format-generated and the copyright-header formatting
             are applied to the same tree that is committed) and then diffs the working tree. -->
        <openapi.output.dir>${project.basedir}</openapi.output.dir>
    </properties>

    <dependencies>
        <!-- Jackson: chosen JSON library for the SDK -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
        <!-- java.time support for date/date-time wire fields -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Opt-in regeneration: `./mvnw -Pcodegen generate-sources`. Generated sources under
             src/main/kotlin/com/ratepay/sdk/model/api are committed and are the authoritative
             input for compilation, ktlint and SonarQube, so an ordinary build must not run
             codegen. Drift check: regenerate, then `git diff` on that tree must be empty. -->
        <profile>
            <id>codegen</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openapitools</groupId>
                        <artifactId>openapi-generator-maven-plugin</artifactId>
                        <version>${openapi-generator.version}</version>
                        <executions>
                            <execution>
                                <id>generate-payment-api-models</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <inputSpec>${openapi.spec.file}</inputSpec>
                                    <generatorName>kotlin</generatorName>
                                    <output>${openapi.output.dir}</output>
                                    <skipValidateSpec>true</skipValidateSpec>
                                    <!-- kotlin generator writes under <output>/src/main/kotlin/<package> -->
                                    <modelPackage>${openapi.model.package.payment}</modelPackage>

                                    <!-- Local overrides of the stock kotlin-client templates
                                         (model.mustache: drops the self-package import block;
                                         enum_class.mustache: requireNotNull in decode()). Re-sync
                                         both when ${openapi-generator.version} is bumped. -->
                                    <templateDirectory>${project.basedir}/codegen/templates</templateDirectory>

                                    <!-- Models only: no API client, no invoker, no supporting files. -->
                                    <generateApis>false</generateApis>
                                    <generateModels>true</generateModels>
                                    <generateSupportingFiles>false</generateSupportingFiles>
                                    <generateModelTests>false</generateModelTests>
                                    <generateModelDocumentation>false</generateModelDocumentation>

                                    <inlineSchemaOptions>
                                        <inlineSchemaOption>RESOLVE_INLINE_ENUMS=true</inlineSchemaOption>
                                    </inlineSchemaOptions>

                                    <additionalProperties>
                                        <additionalProperty>enumUnknownDefaultCase=true</additionalProperty>
                                    </additionalProperties>

                                    <enumNameMappings>
                                        <enumNameMapping>unknown_default_open_api=UNKNOWN</enumNameMapping>
                                    </enumNameMappings>

                                    <inlineSchemaNameMappings>
                                        <inlineSchemaNameMapping>DeclineDto_category=DeclineCategory</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>DeclineDto_reasons_inner=DeclineReason</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>LookupAllCancellationsFullResponseDto__embedded=CancellationEmbeddedResponse</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>LookupAllCapturesFullResponseDto__embedded=CaptureEmbeddedResponse</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>LookupAllIncrementalAuthsFullResponseDto__embedded=IncrementalAuthorizationEmbeddedResponse</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>LookupAllRefundsFullResponseDto__embedded=RefundEmbeddedResponse</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>BrandingSettingsDto_logo_position=LogoPosition</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>OptionsDto_sales_channel=SalesChannel</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>PaymentMethodDto_payment_option=PaymentOption</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>PaymentMethodDto_transfer_type=TransferType</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>RiskDto_reasons_inner=RiskReason</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>ShippingInformationRequestDto_carrier_name=CarrierName</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>SlangDto_formal_tone=FormalTone</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>SlangDto_name_format=NameFormat</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>SlangDto_transaction_type=SlangTransactionType</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>SpecialItemDto_type=SpecialItemType</inlineSchemaNameMapping>
                                        <inlineSchemaNameMapping>LookupTransactionFullResponseDto_result=TransactionStatus</inlineSchemaNameMapping>
                                    </inlineSchemaNameMappings>

                                    <!-- The 6 "*SelfLink" schemas are all a single required
                                         "href: string", so they map onto the generated Link class;
                                         the 6 "*Links" wrappers are a single required
                                         "self: <ResourceSelfLink>", so they map onto the hand-written
                                         extension.ResponseLinks. Revisit if the spec ever diverges one
                                         of them. -->
                                    <schemaMappings>
                                        <schemaMapping>CancellationSelfLink=com.ratepay.sdk.model.api.payment.Link</schemaMapping>
                                        <schemaMapping>CaptureSelfLink=com.ratepay.sdk.model.api.payment.Link</schemaMapping>
                                        <schemaMapping>IncrementalAuthorizationSelfLink=com.ratepay.sdk.model.api.payment.Link</schemaMapping>
                                        <schemaMapping>RefundSelfLink=com.ratepay.sdk.model.api.payment.Link</schemaMapping>
                                        <schemaMapping>ShippingInformationSelfLink=com.ratepay.sdk.model.api.payment.Link</schemaMapping>
                                        <schemaMapping>TransactionSelfLink=com.ratepay.sdk.model.api.payment.Link</schemaMapping>
                                        <schemaMapping>CancellationLinks=com.ratepay.sdk.model.extension.ResponseLinks</schemaMapping>
                                        <schemaMapping>CaptureLinks=com.ratepay.sdk.model.extension.ResponseLinks</schemaMapping>
                                        <schemaMapping>IncrementalAuthorizationLinks=com.ratepay.sdk.model.extension.ResponseLinks</schemaMapping>
                                        <schemaMapping>RefundLinks=com.ratepay.sdk.model.extension.ResponseLinks</schemaMapping>
                                        <schemaMapping>ShippingInformationLinks=com.ratepay.sdk.model.extension.ResponseLinks</schemaMapping>
                                        <schemaMapping>TransactionLinks=com.ratepay.sdk.model.extension.ResponseLinks</schemaMapping>
                                        <schemaMapping>DeclineDto=com.ratepay.sdk.model.extension.Decline</schemaMapping>
                                        <schemaMapping>BadRequestDeclineDto_category=com.ratepay.sdk.model.api.payment.DeclineCategory</schemaMapping>
                                        <schemaMapping>CancellationRejectedDeclineDto_category=com.ratepay.sdk.model.api.payment.DeclineCategory</schemaMapping>
                                        <schemaMapping>LegalDeclineDto_category=com.ratepay.sdk.model.api.payment.DeclineCategory</schemaMapping>
                                        <schemaMapping>ResourceNotFoundDeclineDto_category=com.ratepay.sdk.model.api.payment.DeclineCategory</schemaMapping>
                                        <schemaMapping>TransactionCreateRejectedDeclineDto_category=com.ratepay.sdk.model.api.payment.DeclineCategory</schemaMapping>
                                        <schemaMapping>BadRequestDeclineDto_reasons_inner=com.ratepay.sdk.model.api.payment.DeclineReason</schemaMapping>
                                        <schemaMapping>CancellationRejectedDeclineDto_reasons_inner=com.ratepay.sdk.model.api.payment.DeclineReason</schemaMapping>
                                        <schemaMapping>CaptureCreateRejectedDeclineDto_reasons_inner=com.ratepay.sdk.model.api.payment.DeclineReason</schemaMapping>
                                        <schemaMapping>IncrementalAuthorizationCreateRejectedDeclineDto_reasons_inner=com.ratepay.sdk.model.api.payment.DeclineReason</schemaMapping>
                                        <schemaMapping>LegalDeclineDto_reasons_inner=com.ratepay.sdk.model.api.payment.DeclineReason</schemaMapping>
                                        <schemaMapping>RefundCreateRejectedDeclineDto_reasons_inner=com.ratepay.sdk.model.api.payment.DeclineReason</schemaMapping>
                                        <schemaMapping>ResourceNotFoundDeclineDto_reasons_inner=com.ratepay.sdk.model.api.payment.DeclineReason</schemaMapping>
                                        <schemaMapping>TransactionCreateRejectedDeclineDto_reasons_inner=com.ratepay.sdk.model.api.payment.DeclineReason</schemaMapping>
                                        <schemaMapping>UnprocessableOperationNotAllowedForDeclinedTransaction_reasons_inner=com.ratepay.sdk.model.api.payment.DeclineReason</schemaMapping>
                                        <schemaMapping>TransactionMinimalResponseDto_result=com.ratepay.sdk.model.api.payment.TransactionStatus</schemaMapping>
                                    </schemaMappings>
                                    <!-- Strips the "Dto" suffix that is part of the spec's own schema
                                         names. KEEP IN SYNC: when the pinned spec gains a new schema
                                         ending in "Dto", add an entry here before regenerating. -->
                                    <modelNameMappings>
                                        <modelNameMapping>AddressDto=Address</modelNameMapping>
                                        <modelNameMapping>BadRequestDeclineDto=BadRequestDecline</modelNameMapping>
                                        <modelNameMapping>BadRequestErrorResponseDto=BadRequestErrorResponse</modelNameMapping>
                                        <modelNameMapping>BankDetailsRequestDto=DebitBankAccount</modelNameMapping>
                                        <modelNameMapping>BankDetailsResponseDto=DepositBankAccount</modelNameMapping>
                                        <modelNameMapping>BrandingSettingsDto=BrandingSettings</modelNameMapping>
                                        <modelNameMapping>BrowserDto=Browser</modelNameMapping>
                                        <modelNameMapping>BuyerDto=Buyer</modelNameMapping>
                                        <modelNameMapping>CancellationFullResponseDto=Cancellation</modelNameMapping>
                                        <modelNameMapping>CancellationMinimalResponseDto=CancellationMinimalResponse</modelNameMapping>
                                        <modelNameMapping>CancellationRejectedDeclineDto=CancellationRejectedDecline</modelNameMapping>
                                        <modelNameMapping>CancellationRejectedErrorResponseDto=CancellationRejectedErrorResponse</modelNameMapping>
                                        <modelNameMapping>CancellationRequestDto=CancellationRequest</modelNameMapping>
                                        <modelNameMapping>CaptureCreateRejectedDeclineDto=CaptureCreateRejectedDecline</modelNameMapping>
                                        <modelNameMapping>CaptureCreateRejectedErrorResponseDto=CaptureCreateRejectedErrorResponse</modelNameMapping>
                                        <modelNameMapping>CaptureFullResponseDto=Capture</modelNameMapping>
                                        <modelNameMapping>CaptureMinimalResponseDto=CaptureMinimalResponse</modelNameMapping>
                                        <modelNameMapping>CaptureRequestDto=CaptureRequest</modelNameMapping>
                                        <modelNameMapping>ChangeDto=ChangeTransactionRequest</modelNameMapping>
                                        <modelNameMapping>ChangeRejectedErrorResponseDto=ChangeRejectedErrorResponse</modelNameMapping>
                                        <modelNameMapping>CompanyDto=Company</modelNameMapping>
                                        <modelNameMapping>ComplianceDetailsDto=ComplianceDetails</modelNameMapping>
                                        <modelNameMapping>ContactDto=Contact</modelNameMapping>
                                        <modelNameMapping>CorrespondenceSettingsDto=CorrespondenceSettings</modelNameMapping>
                                        <!-- DeclineDto is deliberately absent here: it is redirected to the
                                             hand-written com.ratepay.sdk.model.extension.Decline via
                                             schemaMappings above, so it must not be renamed as a model. -->
                                        <modelNameMapping>DeliveryDto=Delivery</modelNameMapping>
                                        <modelNameMapping>DeviceDto=Device</modelNameMapping>
                                        <modelNameMapping>DeviceLookupResponseDto=DeviceLookupResponse</modelNameMapping>
                                        <modelNameMapping>GeoLocationDto=GeoLocation</modelNameMapping>
                                        <modelNameMapping>IncrementalAuthorizationCreateRejectedDeclineDto=IncrementalAuthorizationCreateRejectedDecline</modelNameMapping>
                                        <modelNameMapping>IncrementalAuthorizationCreateRejectedErrorResponseDto=IncrementalAuthorizationCreateRejectedErrorResponse</modelNameMapping>
                                        <modelNameMapping>IncrementalAuthorizationFullResponseDto=IncrementalAuthorization</modelNameMapping>
                                        <modelNameMapping>IncrementalAuthorizationMinimalResponseDto=IncrementalAuthorizationMinimalResponse</modelNameMapping>
                                        <modelNameMapping>IncrementalAuthorizationRequestDto=IncrementalAuthorizationRequest</modelNameMapping>
                                        <modelNameMapping>InStoreCollectDto=InStoreCollect</modelNameMapping>
                                        <modelNameMapping>ItemDto=Item</modelNameMapping>
                                        <modelNameMapping>LegalDeclineDto=LegalDecline</modelNameMapping>
                                        <modelNameMapping>LegalErrorResponseDto=LegalErrorResponse</modelNameMapping>
                                        <modelNameMapping>LinkDto=Link</modelNameMapping>
                                        <modelNameMapping>LinksDto=OtpLinks</modelNameMapping>
                                        <modelNameMapping>LookupAllCancellationsFullResponseDto=Cancellations</modelNameMapping>
                                        <modelNameMapping>LookupAllCancellationsMinimalResponseDto=LookupAllCancellationsMinimalResponse</modelNameMapping>
                                        <modelNameMapping>LookupAllCapturesFullResponseDto=Captures</modelNameMapping>
                                        <!-- The "__embedded" children of the LookupAll*FullResponseDto
                                             schemas are inline schemas, so they are renamed through
                                             inlineSchemaNameMappings above, not here. -->
                                        <modelNameMapping>LookupAllCapturesMinimalResponseDto=LookupAllCapturesMinimalResponse</modelNameMapping>
                                        <modelNameMapping>LookupAllIncrementalAuthsFullResponseDto=IncrementalAuthorizations</modelNameMapping>
                                        <modelNameMapping>LookupAllIncrementalAuthsMinimalResponseDto=LookupAllIncrementalAuthsMinimalResponse</modelNameMapping>
                                        <modelNameMapping>LookupAllRefundsFullResponseDto=Refunds</modelNameMapping>
                                        <modelNameMapping>LookupAllRefundsMinimalResponseDto=LookupAllRefundsMinimalResponse</modelNameMapping>
                                        <modelNameMapping>LookupTransactionFullResponseDto=Transaction</modelNameMapping>
                                        <modelNameMapping>LookupTransactionMinimalResponseDto=LookupTransactionMinimalResponse</modelNameMapping>
                                        <modelNameMapping>MerchantDto=Merchant</modelNameMapping>
                                        <modelNameMapping>MessageDto=Message</modelNameMapping>
                                        <modelNameMapping>OptionsDto=Options</modelNameMapping>
                                        <modelNameMapping>OtpDetailsDto=OtpDetails</modelNameMapping>
                                        <modelNameMapping>LookupTransactionLinks=TransactionLinks</modelNameMapping>
                                        <modelNameMapping>PaymentDetailsFullResponseDto=PaymentDetails</modelNameMapping>
                                        <modelNameMapping>PaymentDetailsMinimalResponseDto=PaymentDetailsMinimalResponse</modelNameMapping>
                                        <modelNameMapping>PaymentDetailsMinimalResponseLegacyDto=AuthorizationPaymentDetails</modelNameMapping>
                                        <modelNameMapping>PaymentDetailsRequestDto=SepaDirectDebitPaymentDetails</modelNameMapping>
                                        <modelNameMapping>PaymentMethodDto=PaymentMethod</modelNameMapping>
                                        <modelNameMapping>PaymentReferenceDto=PaymentReference</modelNameMapping>
                                        <modelNameMapping>PersonDto=Person</modelNameMapping>
                                        <modelNameMapping>PickUpBoxDto=PickUpBox</modelNameMapping>
                                        <modelNameMapping>PickUpShopDto=PickUpShop</modelNameMapping>
                                        <modelNameMapping>RefundCreateRejectedDeclineDto=RefundCreateRejectedDecline</modelNameMapping>
                                        <modelNameMapping>RefundCreateRejectedErrorResponseDto=RefundCreateRejectedErrorResponse</modelNameMapping>
                                        <modelNameMapping>RefundFullResponseDto=Refund</modelNameMapping>
                                        <modelNameMapping>RefundMinimalResponseDto=RefundMinimalResponse</modelNameMapping>
                                        <modelNameMapping>RefundRequestDto=RefundRequest</modelNameMapping>
                                        <modelNameMapping>ResourceNotFoundDeclineDto=ResourceNotFoundDecline</modelNameMapping>
                                        <modelNameMapping>ResourceNotFoundErrorResponseDto=ResourceNotFoundErrorResponse</modelNameMapping>
                                        <modelNameMapping>RiskDto=Risk</modelNameMapping>
                                        <modelNameMapping>ScreenDto=Screen</modelNameMapping>
                                        <!-- SecciApi*/SecciEmailResponse* schemas are generated by the
                                             separate generate-secci-api-models execution below, into
                                             com.ratepay.sdk.model.api.secci. -->
                                        <modelNameMapping>ShippingInformationMinimalResponseDto=ShippingInformationResponse</modelNameMapping>
                                        <modelNameMapping>ShippingInformationRequestDto=ShippingInformationRequest</modelNameMapping>
                                        <modelNameMapping>ShopBasketDto=ShopBasket</modelNameMapping>
                                        <modelNameMapping>ShopDto=Shop</modelNameMapping>
                                        <modelNameMapping>ShopLegalDto=ShopLegal</modelNameMapping>
                                        <modelNameMapping>ShopLookupResponseDto=ShopLookupResponse</modelNameMapping>
                                        <modelNameMapping>SlangDto=Slang</modelNameMapping>
                                        <modelNameMapping>SlangsDto=Slangs</modelNameMapping>
                                        <modelNameMapping>SpecialItemDto=SpecialItem</modelNameMapping>
                                        <modelNameMapping>TransactionBadRequestErrorDto=TransactionBadRequestError</modelNameMapping>
                                        <modelNameMapping>TransactionCreateRejectedDeclineDto=TransactionCreateRejectedDecline</modelNameMapping>
                                        <modelNameMapping>TransactionCreateRejectedErrorResponseDto=TransactionCreateRejectedErrorResponse</modelNameMapping>
                                        <modelNameMapping>TransactionMinimalResponseDto=AuthorizationResponse</modelNameMapping>
                                        <modelNameMapping>TransactionRequestDto=AuthorizationRequest</modelNameMapping>
                                        <modelNameMapping>VatDto=Vat</modelNameMapping>
                                    </modelNameMappings>
                                    <configOptions>
                                        <serializationLibrary>jackson</serializationLibrary>
                                        <dateLibrary>java8</dateLibrary>
                                        <enumPropertyNaming>original</enumPropertyNaming>
                                        <enumUnknownDefaultCase>true</enumUnknownDefaultCase>

                                    </configOptions>
                                </configuration>
                            </execution>

                            <!-- SECCI/compliance-document schemas (POST /v2/compliance/secci),
                                 generated from the SAME pinned spec into a separate package and
                                 restricted to this closed schema set via the "models" global
                                 property below. -->
                            <execution>
                                <id>generate-secci-api-models</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <inputSpec>${openapi.spec.file}</inputSpec>
                                    <generatorName>kotlin</generatorName>
                                    <output>${openapi.output.dir}</output>
                                    <skipValidateSpec>true</skipValidateSpec>
                                    <modelPackage>${openapi.model.package.secci}</modelPackage>

                                    <!-- Same local template overrides as the payment execution above. -->
                                    <templateDirectory>${project.basedir}/codegen/templates</templateDirectory>

                                    <generateApis>false</generateApis>
                                    <generateModels>true</generateModels>
                                    <generateSupportingFiles>false</generateSupportingFiles>
                                    <generateModelTests>false</generateModelTests>
                                    <generateModelDocumentation>false</generateModelDocumentation>

                                    <inlineSchemaOptions>
                                        <inlineSchemaOption>RESOLVE_INLINE_ENUMS=true</inlineSchemaOption>
                                    </inlineSchemaOptions>

                                    <additionalProperties>
                                        <additionalProperty>enumUnknownDefaultCase=true</additionalProperty>
                                    </additionalProperties>

                                    <enumNameMappings>
                                        <enumNameMapping>unknown_default_open_api=UNKNOWN</enumNameMapping>
                                        <!-- The spec declares these SECCI values as lowercase, which
                                             would produce lowercase enum entries. Only the entry NAMES
                                             are uppercased; wire values stay lowercase via @JsonProperty. -->
                                        <enumNameMapping>download=DOWNLOAD</enumNameMapping>
                                        <enumNameMapping>print=PRINT</enumNameMapping>
                                        <enumNameMapping>email=EMAIL</enumNameMapping>
                                        <enumNameMapping>pdf=PDF</enumNameMapping>
                                    </enumNameMappings>

                                    <!-- KEEP IN SYNC: RESOLVE_INLINE_ENUMS promotes inline enums to
                                         standalone schemas AFTER this filter is applied, so each
                                         "<Parent>_<property>" entry must be listed explicitly
                                         alongside its parent. -->
                                    <globalProperties>
                                        <models>SecciApiDeliveryDto,SecciApiItemDto,SecciApiPaymentMethodDto,SecciApiRequestDto,SecciApiShopBasketDto,SecciApiSpecialItemDto,SecciEmailResponseDto,SecciApiDeliveryDto_action,SecciApiDeliveryDto_method,SecciApiPaymentMethodDto_payment_option,SecciEmailResponseDto_result</models>
                                    </globalProperties>

                                    <!-- Drops the "SecciApi" prefix from the spec's own schema
                                         names and the "Dto" suffix, replacing it with an explicit
                                         "Secci" prefix on every model. The underscore-suffixed names are
                                         the promoted inline enums. -->
                                    <modelNameMappings>
                                        <modelNameMapping>SecciApiDeliveryDto=SecciDelivery</modelNameMapping>
                                        <modelNameMapping>SecciApiDeliveryDto_action=SecciDeliveryAction</modelNameMapping>
                                        <modelNameMapping>SecciApiDeliveryDto_method=SecciDeliveryMethod</modelNameMapping>
                                        <modelNameMapping>SecciApiItemDto=SecciItem</modelNameMapping>
                                        <modelNameMapping>SecciApiPaymentMethodDto=SecciPaymentMethod</modelNameMapping>
                                        <modelNameMapping>SecciApiPaymentMethodDto_payment_option=SecciPaymentMethodOption</modelNameMapping>
                                        <modelNameMapping>SecciApiRequestDto=SecciRequest</modelNameMapping>
                                        <modelNameMapping>SecciApiShopBasketDto=SecciShopBasket</modelNameMapping>
                                        <modelNameMapping>SecciApiSpecialItemDto=SecciSpecialItem</modelNameMapping>
                                        <modelNameMapping>SecciEmailResponseDto=SecciEmailResponse</modelNameMapping>
                                        <modelNameMapping>SecciEmailResponseDto_result=SecciEmailResponseResult</modelNameMapping>
                                    </modelNameMappings>

                                    <configOptions>
                                        <serializationLibrary>jackson</serializationLibrary>
                                        <dateLibrary>java8</dateLibrary>
                                        <enumPropertyNaming>original</enumPropertyNaming>
                                        <enumUnknownDefaultCase>true</enumUnknownDefaultCase>
                                    </configOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Generated sources are excluded from ktlint check (style is governed by the
                         generator template) and auto-formatted here, right after codegen and before
                         the inherited ktlint-check in process-sources. -->
                    <plugin>
                        <groupId>com.github.gantsign.maven</groupId>
                        <artifactId>ktlint-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ktlint-format-generated</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>format</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Stamps build-tools/copyright-header.txt onto the freshly generated sources so
                         they satisfy the check-copyright-headers execution inherited from the parent,
                         which runs later in process-sources. Existing headers are left untouched. -->
                    <plugin>
                        <groupId>com.mycila</groupId>
                        <artifactId>license-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>format-generated-copyright-headers</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>format</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
